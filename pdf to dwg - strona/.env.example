# Domena strony (rekord A/AAAA musi wskazywać na serwer) — Caddy sam wystawi certyfikat HTTPS.
SITE_ADDRESS=pdf2dwg.example.pl

# Silnik DWG: none (tylko DXF) albo command (własne polecenie konwersji DXF → DWG).
# "oda" działa tylko do użytku lokalnego — licencja ODA File Converter zabrania usług dla osób trzecich.
PDF2DWG_DWG_ENGINE=none
# Dla "command": {input}, {output}, {version} są podstawiane, np.
# PDF2DWG_DWG_COMMAND=dxf2dwg {input} {output} {version}
# PDF2DWG_DWG_VERSIONS=R2000,R2004,R2010,R2013,R2018

# Link do kodu źródłowego w stopce — WYMAGANY przy publicznej stronie (licencja AGPL PyMuPDF).
PDF2DWG_SOURCE_URL=
# Adres e-mail albo URL kontaktu w stopce (opcjonalnie).
PDF2DWG_CONTACT=

# Wydajność i ochrona serwera (to nie są limity dla użytkownika — nikt nie ma dziennego limitu).
PDF2DWG_WORKERS=2
PDF2DWG_MAX_UPLOAD_MB=50
PDF2DWG_MAX_PAGES=100
PDF2DWG_JOB_TIMEOUT=180
# Limit pamięci jednej konwersji (MB). Złośliwy 5 MB PDF potrafi zająć kilka GB — po przekroczeniu
# konwersja jest przerywana. WORKERS × JOB_MEMORY_MB musi się zmieścić w mem_limit (docker-compose.yml).
PDF2DWG_JOB_MEMORY_MB=1500
PDF2DWG_MAX_QUEUE=50
PDF2DWG_MAX_ACTIVE_PER_CLIENT=6
PDF2DWG_RETENTION_MINUTES=30
PDF2DWG_MIN_FREE_MB=1024
